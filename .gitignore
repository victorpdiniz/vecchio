# Dependências
node_modules/

# Builds
dist/
build/

# Variáveis de ambiente (nunca commitar segredos reais)
.env
.env.local
!.env.example

# Banco de dados SQLite local
backend/*.db
backend/*.db-journal
backend/prisma/*.db
backend/prisma/*.db-journal

# Arquivos enviados pelos usuários (boletos, PDFs)
backend/uploads/*
!backend/uploads/.gitkeep

# Sandbox local do utilitário de pendrive (fase 8) — mantém a estrutura
# de exemplo em usb-sandbox/documentos/, ignora o que for copiado pra
# "dentro do pendrive" durante testes.
backend/usb-sandbox/drives/*
!backend/usb-sandbox/drives/.gitkeep

# Logs
*.log
npm-debug.log*

# Editor / SO
.vscode/
.idea/
.DS_Store

# Índice do CodeGraph (ferramenta local de indexação de código)
.codegraph/
