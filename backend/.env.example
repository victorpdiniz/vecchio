# Copie este arquivo para ".env" e preencha os valores reais.

# Caminho do arquivo SQLite (relativo à pasta backend/)
DATABASE_URL="file:./dev.db"

# Porta em que a API Fastify vai rodar
PORT=3333

# Chave da API do Gemini (Google Generative AI) — usada pelo módulo de chat
GEMINI_API_KEY=""

# Chave usada para criptografar as senhas guardadas no cofre (32 bytes em hex)
PASSWORD_ENCRYPTION_KEY=""

# SMTP — usado para enviar os lembretes por e-mail
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vecchio <no-reply@vecchio.local>"

# Utilitário de pendrive: caminhos DENTRO do container (não do host!) — o
# docker-compose.yml monta os caminhos reais do host nesses pontos. Em dev,
# cai por padrão num sandbox local em backend/usb-sandbox/ para dar pra
# testar sem tocar no filesystem real; em produção, aponte
# USB_HOST_DOCUMENTS_DIR/USB_HOST_DRIVES_DIR (no .env da raiz do projeto,
# lido pelo docker-compose) para as pastas reais do host.
USB_BASE_DIR="/usb-documentos"
USB_DRIVES_DIR="/usb-drives"

# Branch que o botão de autoatualização (qualquer perfil, no cabeçalho)
# compara com o repositório local para saber se há atualização disponível.
UPDATE_BRANCH="dev"
