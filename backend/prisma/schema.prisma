// Vecchio — schema do banco de dados (SQLite)
// Ver plano em docs/ e o histórico de commits para o contexto de cada módulo.
//
// SQLite não suporta enums nativos no Prisma, então os campos "enum-like"
// abaixo são String — os valores válidos são fixados nas constantes em
// src/lib/enums.ts e validados via Zod na camada de controller.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id         String   @id @default(cuid())
  name       String
  role       String   @unique // "avo" | "avo_f" | "pai" | "admin"
  email      String
  colorTag   String
  avatarIcon String
  createdAt  DateTime @default(now())

  medicines                Medicine[]
  bills                    Bill[]                    @relation("BillPayer")
  createdBills             Bill[]                    @relation("BillCreator")
  uploadedAttachments      Attachment[]
  chatMessages             ChatMessage[]
  googleCalendarConnection GoogleCalendarConnection?
}

model AgendaItem {
  id                String    @id @default(cuid())
  title             String
  category          String    @default("outro") // "consulta" | "exame" | "conta" | "remedio" | "viagem" | "outro"
  isAllDay          Boolean   @default(false)
  startAt           DateTime
  endAt             DateTime?
  billId            String?   @unique
  bill              Bill?     @relation(fields: [billId], references: [id])
  // Recorrência: itens gerados a partir de um mesmo compromisso recorrente
  // compartilham recurrenceGroupId. recurrenceRule nulo = compromisso avulso.
  recurrenceRule    String? // "diaria" | "semanal" | "mensal" | "anual"
  recurrenceGroupId String?
  recurrenceEndDate DateTime?
  // Id do evento espelhado na agenda do Google (Admin), se sincronizado.
  googleEventId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reminders AgendaReminder[]
}

// Um compromisso pode ter vários lembretes (estilo Google Agenda). Guarda a
// especificação original (kind + amount/unit OU daysBefore/atHour/atMinute)
// além do triggerAt/label já computados, para o scan de notificações não
// precisar recalcular nada e a edição poder repopular o formulário.
model AgendaReminder {
  id           String     @id @default(cuid())
  agendaItemId String
  agendaItem   AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  kind         String // "relative" (compromissos com hora) | "allday" (dia inteiro)
  amount       Int? // relative: quantidade de `unit`
  unit         String? // relative: "minutes" | "hours" | "days" | "weeks"
  daysBefore   Int? // allday: quantos dias antes do dia do compromisso
  atHour       Int? // allday: hora do aviso (0-23)
  atMinute     Int? // allday: minuto do aviso (0-59)
  triggerAt    DateTime // horário absoluto do aviso, recalculado a cada save
  label        String // texto amigável, ex: "30 minutos antes" ou "1 dia antes às 09:00"

  notifications NotificationLog[]
}

model Medicine {
  id        String    @id @default(cuid())
  name      String
  dosage    String
  profileId String?
  profile   Profile?  @relation(fields: [profileId], references: [id])
  notes     String?
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())

  schedules MedicineSchedule[]
}

model MedicineSchedule {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  timeOfDay  String // "HH:mm"
  daysOfWeek String // csv, ex: "0,1,2,3,4,5,6"
}

model Bill {
  id             String    @id @default(cuid())
  description    String
  amount         Float
  dueDate        DateTime
  category       String
  isRecurring    Boolean   @default(false)
  recurrenceRule String? // ex: "monthly"
  status         String    @default("pendente") // "pendente" | "pago"
  payerProfileId String?
  payerProfile   Profile?  @relation("BillPayer", fields: [payerProfileId], references: [id])
  paidAt         DateTime?
  createdById    String
  createdBy      Profile   @relation("BillCreator", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attachments Attachment[]
  agendaItem  AgendaItem?
}

model Attachment {
  id           String   @id @default(cuid())
  billId       String
  bill         Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  filename     String
  storagePath  String
  uploadedById String
  uploadedBy   Profile  @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
}

model Password {
  id                String   @id @default(cuid())
  siteName          String
  url               String?
  username          String
  passwordEncrypted String
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NotificationLog {
  id         String         @id @default(cuid())
  reminderId String
  reminder   AgendaReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  channel    String // "inapp" | "email"
  sentTo     String
  sentAt     DateTime       @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  role      String // "user" | "model"
  content   String
  createdAt DateTime @default(now())
}

// Conexão OAuth do Admin com o Google Calendar — linha única, usada para
// espelhar os compromissos não-privados da família numa agenda dedicada
// ("Vecchio — Família") na conta pessoal do Admin.
model GoogleCalendarConnection {
  id               String    @id @default(cuid())
  profileId        String    @unique
  profile          Profile   @relation(fields: [profileId], references: [id])
  accessToken      String
  refreshToken     String
  expiryDate       DateTime?
  googleCalendarId String
  connectedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
